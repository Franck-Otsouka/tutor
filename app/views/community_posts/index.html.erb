<div class="container-fluid py-4">

  <!-- Community Header -->

  <div class="mb-4">


<h1 class="fw-bold mb-1">
  <%= @community_group.name %>
</h1>

<p class="text-muted mb-0">
  Community discussions and conversations.
</p>


  </div>

  <!-- Three Column Forum Layout -->

  <div class="row g-4">


<!-- LEFT: Community Members -->

<div class="col-lg-3">

  <div class="card border-0 shadow-sm">

    <div class="card-body">

      <h5 class="fw-bold mb-3">

        <i class="bi bi-people me-2"></i>
        Community Members

      </h5>

      <p class="small text-muted mb-3">
        Members of this community can participate
        in the discussion.
      </p>

      <div class="d-flex justify-content-between mb-3">

        <span class="text-muted">
          Members
        </span>

        <strong>
          <%= @community_group.users.count %>
        </strong>

      </div>

      <hr>

      <% @community_group.users.limit(8).each do |user| %>

        <div class="d-flex align-items-center mb-3">

          <% if user.avatar.attached? %>

            <%= image_tag user.avatar,
                class: "rounded-circle me-2",
                style: "width:36px;height:36px;object-fit:cover;" %>

          <% else %>

            <div
              class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2"
              style="width:36px;height:36px;">

              <i class="bi bi-person"></i>

            </div>

          <% end %>

          <div class="small">

            <div class="fw-semibold">
              <%= user.first_name %>
              <%= user.last_name %>
            </div>

            <div class="text-muted">
              <%= user.coach? ? "Coach" : "Student" %>
            </div>

          </div>

        </div>

      <% end %>

      <% if @community_group.users.count > 8 %>

        <div class="text-muted small">
          + <%= @community_group.users.count - 8 %> more members
        </div>

      <% end %>

    </div>

  </div>

</div>


<!-- CENTER: FORUM -->

<div class="col-lg-6">

  <!-- Forum Topic -->

  <div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

      <div class="small text-uppercase text-muted fw-semibold mb-1">
        Forum Topic
      </div>

      <h4 class="fw-bold mb-2">
        <%= @community_group.name %>
      </h4>

      <p class="mb-0 text-muted">
        <strong>Topic:</strong>
        Which language is the best for web development?
      </p>

    </div>

  </div>


  <!-- Scrollable Discussion Feed -->

  <div
    class="card border-0 shadow-sm">

    <div
      class="card-body p-3"
      style="height: 650px; overflow-y: auto;">

      <% if @community_posts.any? %>

        <% @community_posts.each do |post| %>

          <!-- Forum Post -->

         <div class="card border-0 shadow-sm mb-4" style="background-color: #f1f3f5;">

            <div class="card-body p-3">

              <div class="d-flex align-items-start">


                <!-- Media -->


                <!-- Avatar -->

                <div class="me-3 flex-shrink-0">

                  <% if post.user.avatar.attached? %>

                    <%= image_tag post.user.avatar,
                        class: "rounded-circle flex-shrink-0",
                        style: "width:42px;height:42px;object-fit:cover;" %>

                  <% else %>

                    <div
                      class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                      style="width:42px;height:42px;">

                      <i class="bi bi-person"></i>

                    </div>

                  <% end %>

                </div>


                <!-- Post Content -->

                <div class="flex-grow-1 overflow-hidden">

                  <div class="d-flex align-items-center gap-2 mb-1">

                    <span class="fw-semibold">

                      <%= post.user.first_name %>
                      <%= post.user.last_name %>

                    </span>

                    <small class="text-muted">

                      <%= time_ago_in_words(post.created_at) %> ago

                    </small>

                  </div>


                  <% if post.content.present? %>

                    <p class="mb-2">

                      <%= strip_tags(post.content).truncate(180) %>

                    </p>

                  <% end %>

                <% if post.media.attached? %>

                  <div class="mt-3 mb-3">

                    <%= image_tag post.media,
                        class: "img-fluid rounded",
                        style: "max-height:400px;object-fit:contain;" %>

                  </div>

                <% end %>


                  <% if post.link_url.present? %>

                    <div class="small text-primary text-truncate">

                      <i class="bi bi-link-45deg"></i>

                      <%= post.link_url %>

                    </div>

                  <% end %>

                  <!-- Reply -->

                  <div class="mt-3">

                    <button
                      type="button"
                      class="reply-action"
                      data-bs-toggle="modal"
                      data-bs-target="#replyModal<%= post.id %>"
                      aria-label="Reply to this post">

                      <i class="bi bi-arrow-return-right"></i>

                      <span class="reply-label">
                        Reply
                      </span>

                    </button>

                  </div>

              </div>


                <!-- Options -->

                <div class="ms-2 flex-shrink-0">

                  <div class="dropdown">

                    <button
                      type="button"
                      class="btn btn-sm btn-light border"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      aria-label="Post options">

                      <i class="bi bi-three-dots-vertical"></i>

                    </button>


                    <ul class="dropdown-menu dropdown-menu-end">

                      <li>

                        <%= link_to community_group_community_post_path(
                              @community_group,
                              post
                            ),
                            class: "dropdown-item" do %>

                          <i class="bi bi-eye me-2"></i>
                          View Post

                        <% end %>

                      </li>


                      <li>

             <button
                type="button"
                class="dropdown-item"
                data-bs-toggle="modal"
                data-bs-target="#replyModal<%= post.id %>">

                 <i class="bi bi-reply me-2"></i>
                        Reply

              </button>

                      </li>


                      <% if post.user == current_user %>

                        <li>
                          <hr class="dropdown-divider">
                        </li>

                        <li>

                          <%= link_to edit_community_group_community_post_path(
                                @community_group,
                                post
                              ),
                              class: "dropdown-item" do %>

                            <i class="bi bi-pencil me-2"></i>
                            Edit

                          <% end %>

                        </li>


                        <li>

                          <%= button_to community_group_community_post_path(
                                @community_group,
                                post
                              ),
                              method: :delete,
                              class: "dropdown-item text-danger",
                              form: {
                                data: {
                                  turbo_confirm: "Are you sure you want to delete this post?"
                                }
                              } do %>

                            <i class="bi bi-trash me-2"></i>
                            Delete

                          <% end %>

                        </li>

                      <% end %>

                    </ul>

                  </div>

                </div>

              </div>

            </div>

          </div>
          <!-- Reply Modal -->

        <div
          class="modal fade"
          id="replyModal<%= post.id %>"
          tabindex="-1"
          aria-labelledby="replyModalLabel<%= post.id %>"
          aria-hidden="true">

          <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

              <div class="modal-header">

                <div>

                  <h5
                    class="modal-title"
                    id="replyModalLabel<%= post.id %>">

                    Reply to <%= post.user.first_name %>

                  </h5>

                  <small class="text-muted">
                    Replying to this community post
                  </small>

                </div>

                <button
                  type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"
                  aria-label="Close">
                </button>

              </div>

              <div class="modal-body">

              <%= form_with url: create_reply_community_group_community_post_path(
              @community_group,
              post
            ),
            method: :post,
            local: true do |form| %>

          <div class="mb-3">
            <%= form.label :content,
                "Your reply",
                class: "form-label fw-semibold" %>

            <%= form.text_area :content,
                rows: 5,
                class: "form-control",
                placeholder: "Write your reply...",
                required: true %>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <button
              type="button"
              class="btn btn-outline-secondary"
              data-bs-dismiss="modal">
              Cancel
            </button>

            <%= form.submit "Reply",
                class: "btn btn-primary" %>
          </div>

        <% end %>

      </div>

    </div>

  </div>

</div>

        <% end %>


      <% else %>

        <div class="text-center py-5">

          <i class="bi bi-chat-dots display-4 text-muted"></i>

          <h4 class="mt-3">
            No discussions yet
          </h4>

          <p class="text-muted">
            Start the first conversation.
          </p>

        </div>

      <% end %>

    </div>

  </div>

</div>


<!-- RIGHT: NEW POST -->

<div class="col-lg-3">

  <div class="card border-0 shadow-sm">

    <div class="card-body">

      <h5 class="fw-bold mb-3">

        <i class="bi bi-plus-circle me-2"></i>
        Start a Discussion

      </h5>

      <p class="text-muted small">

        Share a question, idea, resource,
        link or photo with the community.

      </p>

      <%= link_to new_community_group_community_post_path(@community_group),
          class: "btn btn-primary w-100" do %>

        <i class="bi bi-plus-lg me-2"></i>
        New Post

      <% end %>

    </div>

  </div>


  <!-- Community Info -->

  <div class="card border-0 shadow-sm mt-4">

    <div class="card-body">

      <h6 class="fw-bold mb-3">
        About this community
      </h6>

      <p class="text-muted small mb-0">
        <%= @community_group.description %>
      </p>

    </div>

  </div>

</div>


  </div>

</div>

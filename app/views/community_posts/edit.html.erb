<div class="container py-5">

  <div class="row justify-content-center">

    <div class="col-lg-8">

      <div class="mb-4">

        <%= link_to "← Back to Hub",
            community_group_community_posts_path(@community_group),
            class: "text-decoration-none" %>

      </div>

      <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

          <h2 class="fw-bold mb-3">
            Edit Community Post
          </h2>

          <p class="text-muted mb-4">
            Update your community post.
          </p>

          <%= form_with model: [@community_group, @community_post],
              local: true do |form| %>

            <% if @community_post.errors.any? %>

              <div class="alert alert-danger">

                <ul class="mb-0">

                  <% @community_post.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>

                </ul>

              </div>

            <% end %>

            <div class="mb-3">

              <%= form.label :content,
                  class: "form-label fw-semibold" %>

              <%= form.text_area :content,
                  rows: 6,
                  class: "form-control",
                  placeholder: "What's on your mind?" %>

            </div>

            <div class="mb-3">

              <%= form.label :link_url,
                  "Link",
                  class: "form-label fw-semibold" %>

              <%= form.url_field :link_url,
                  class: "form-control",
                  placeholder: "https://example.com" %>

            </div>

            <div class="mb-4">

              <%= form.label :media,
                  "Photo",
                  class: "form-label fw-semibold" %>

              <%= form.file_field :media,
                  class: "form-control" %>

              <% if @community_post.media.attached? %>

                <div class="mt-3">

                  <p class="small text-muted mb-2">
                    Current photo:
                  </p>

                  <%= image_tag @community_post.media,
                      class: "img-fluid rounded",
                      style: "max-height: 300px;" %>

                </div>

              <% end %>

            </div>

            <div class="d-flex gap-2">

              <%= link_to "Cancel",
                  community_group_community_posts_path(@community_group),
                  class: "btn btn-outline-secondary" %>

              <%= form.submit "Update Post",
                  class: "btn btn-primary" %>

            </div>

          <% end %>

        </div>

      </div>

    </div>

  </div>

</div>

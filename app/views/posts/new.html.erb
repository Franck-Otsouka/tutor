<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">

      <div class="mb-4">
        <%= link_to "← Back to #{@community_group.name}",
            community_group_posts_path(@community_group),
            class: "text-decoration-none" %>
      </div>

      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

          <div class="mb-4">
            <h1 class="fw-bold mb-2">Create a Post</h1>
            <p class="text-muted mb-0">
              Share something useful with the community.
            </p>
          </div>

          <%= form_with model: @post,
              url: community_group_posts_path(@community_group),
              local: true do |form| %>

            <% if @post.errors.any? %>
              <div class="alert alert-danger">
                <h6 class="fw-bold">
                  Please correct the following:
                </h6>

                <ul class="mb-0">
                  <% @post.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-4">
              <%= form.label :content,
                  "Your post",
                  class: "form-label fw-semibold" %>

              <%= form.text_area :content,
                  class: "form-control",
                  rows: 8,
                  placeholder: "Write your post here..." %>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Cancel",
                  community_group_posts_path(@community_group),
                  class: "btn btn-outline-secondary" %>

              <%= form.submit "Publish Post",
                  class: "btn btn-dark" %>
            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>

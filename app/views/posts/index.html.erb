<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold mb-1"><%= @community_group.name %></h1>
      <p class="text-muted mb-0">Community posts</p>
    </div>

    <% if current_user.coach? %>
      <%= link_to "Create Post",
          new_community_group_post_path(@community_group),
          class: "btn btn-dark" %>
    <% end %>
  </div>

  <% if @posts.any? %>
    <div class="row g-4">
      <% @posts.each do |post| %>
        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <strong>
                    <%= post.user.email %>
                  </strong>

                  <div class="small text-muted">
                    <%= time_ago_in_words(post.created_at) %> ago
                  </div>
                </div>

                <% if post.user == current_user && current_user.coach? %>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-light"
                            type="button"
                            data-bs-toggle="dropdown">
                      <i class="bi bi-three-dots"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                      <li>
                        <%= link_to "Edit",
                            edit_community_group_post_path(
                              @community_group,
                              post
                            ),
                            class: "dropdown-item" %>
                      </li>

                      <li>
                        <%= button_to "Delete",
                            community_group_post_path(
                              @community_group,
                              post
                            ),
                            method: :delete,
                            class: "dropdown-item text-danger",
                            form: {
                              data: {
                                turbo_confirm: "Delete this post?"
                              }
                            } %>
                      </li>
                    </ul>
                  </div>
                <% end %>
              </div>

              <p class="mb-3">
                <%= simple_format(post.content) %>
              </p>

              <%= link_to "View Post",
                  community_group_post_path(@community_group, post),
                  class: "btn btn-outline-dark btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body text-center py-5">
        <i class="bi bi-chat-square-text fs-1 text-muted"></i>
        <h4 class="mt-3">No posts yet</h4>
        <p class="text-muted mb-0">
          Coaches can start the conversation by creating the first post.
        </p>
      </div>
    </div>
  <% end %>
</div>

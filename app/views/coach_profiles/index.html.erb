<div class="container py-5 coach-profiles-page">

  <!-- Page Header -->
  <div class="page-header mb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

      <div>
        <h1 class="mb-2">Find Your Coach</h1>

        <p class="text-muted mb-0">
          Connect with experienced coaches and find the right tutor for your goals.
        </p>
      </div>

      <% if user_signed_in? && !current_user.coach_profile %>
        <%= link_to "Become a Coach",
            new_coach_profile_path,
            class: "btn btn-primary" %>
      <% end %>

    </div>

  </div>


  <!-- Search -->
  <div class="coach-index-search mb-5">

    <%= form_with url: coach_profiles_path,
        method: :get,
        local: true do |form| %>

      <div class="input-group input-group-lg">

        <%= form.search_field :query,
            value: params[:query],
            class: "form-control",
            placeholder: "Search coaches, subjects or expertise...",
            aria: { label: "Search coaches" } %>

        <%= form.submit "Search",
            class: "btn btn-primary px-4" %>

      </div>

    <% end %>

  </div>


  <!-- Results -->
  <% if @coach_profiles.present? %>

    <div class="row g-4">

      <% @coach_profiles.each do |coach| %>

        <div class="col-12 col-md-6 col-lg-4">

          <div class="card coach-card h-100">

            <!-- Avatar -->
            <div class="coach-card-avatar">

              <% if coach.user.avatar.attached? %>

                <%= image_tag coach.user.avatar,
                    class: "coach-avatar",
                    alt: "#{coach.user.first_name} #{coach.user.last_name}" %>

              <% else %>

                <div class="coach-avatar coach-avatar-placeholder">
                  <i class="bi bi-person"></i>
                </div>

              <% end %>

            </div>


            <div class="card-body d-flex flex-column">

              <!-- Name -->
              <h5 class="coach-name">
                <%= coach.user.first_name %>
                <%= coach.user.last_name %>
              </h5>


              <!-- Headline -->
              <p class="coach-headline mb-2">
                <%= coach.headline %>
              </p>


              <!-- Rating -->
              <div class="coach-rating mb-3">

                <span class="stars"
                      aria-label="<%= coach.average_rating %> out of 5 stars">

                  <% 5.times do |i| %>
                    <i class="bi <%= i < coach.average_rating.round ? 'bi-star-fill' : 'bi-star' %>"></i>
                  <% end %>

                </span>

                <span class="rating-value">
                  <%= coach.average_rating %>
                </span>

                <span class="rating-count">
                  (<%= coach.reviews_count %>
                  <%= "review".pluralize(coach.reviews_count) %>)
                </span>

              </div>


              <!-- Description -->
              <p class="card-text text-muted">
                <%= truncate(coach.description, length: 150) %>
              </p>


              <!-- Coach Information -->
              <div class="coach-details mb-3">

                <div class="coach-detail">
                  <i class="bi bi-award"></i>

                  <span>
                    <strong><%= coach.years_experience %></strong>
                    years experience
                  </span>
                </div>


                <% if coach.hourly_rate.present? %>

                  <div class="coach-detail">
                    <i class="bi bi-currency-dollar"></i>

                    <span>
                      From
                      <strong>
                        <%= number_to_currency(coach.hourly_rate) %>
                      </strong>
                      / hour
                    </span>
                  </div>

                <% end %>

              </div>


              <!-- Profile Button -->
              <%= link_to "View Profile",
                  coach_profile_path(coach),
                  class: "btn btn-primary mt-auto w-100" %>

            </div>

          </div>

        </div>

      <% end %>

    </div>


  <% else %>

    <!-- Empty State -->
    <div class="empty-state text-center py-5">

      <i class="bi bi-search display-4 text-muted"></i>

      <% if params[:query].present? %>

        <h3 class="mt-3">No coaches found</h3>

        <p class="text-muted">
          We couldn't find any coaches matching
          "<strong><%= params[:query] %></strong>".
        </p>

        <%= link_to "View All Coaches",
            coach_profiles_path,
            class: "btn btn-outline-primary" %>

      <% else %>

        <h3 class="mt-3">No coaches available</h3>

        <p class="text-muted">
          Check back soon for available coaches.
        </p>

      <% end %>

    </div>

  <% end %>

</div>

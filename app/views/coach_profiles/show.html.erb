<div class="container py-5 coach-profiles-page coach-profile">

  <div class="profile-header">
    <div class="profile-layout">

      <div class="profile-avatar-section">
        <% if @coach_profile.user.avatar.attached? %>
          <%= image_tag @coach_profile.user.avatar,
              class: "profile-coach-avatar",
              alt: "#{@coach_profile.user.first_name} #{@coach_profile.user.last_name}" %>
        <% else %>
          <div class="profile-coach-avatar profile-coach-avatar-placeholder">
            <i class="bi bi-person"></i>
          </div>
        <% end %>
      </div>

      <div class="profile-info-section">
        <h1>
          <%= @coach_profile.user.first_name %>
          <%= @coach_profile.user.last_name %>
        </h1>

        <h4 class="profile-headline">
          <%= @coach_profile.headline %>
        </h4>

        <% if @coach_profile.verified %>
          <span class="badge bg-success mb-3 verified-badge">
            Verified Coach
          </span>
        <% end %>

        <p class="lead profile-description">
          <%= @coach_profile.description %>
        </p>

        <div class="mb-4">
          <strong>Experience:</strong>
          <%= @coach_profile.years_experience %> years
        </div>

        <% if @coach_profile.hourly_rate.present? %>
          <div class="mb-4">
            <strong>Hourly rate:</strong>
            <%= number_to_currency(@coach_profile.hourly_rate) %>
          </div>
        <% end %>

        <%= link_to "Back to Coaches",
            coach_profiles_path,
            class: "btn btn-outline-secondary" %>
      </div>

    </div>
  </div>

  <hr class="my-5">

  <!-- Services -->

  <h2>Services</h2>

  <% if @services.any? %>

    <div class="row g-4 mt-2">

      <% @services.each do |service| %>

        <div class="col-md-6 col-lg-4">

          <div class="card service-card h-100">
            <div class="card-body">

              <h5>
                <%= service.title %>
              </h5>

              <p class="text-muted">
                <%= service.category.name %>
              </p>

              <p>
                <%= truncate(service.description, length: 120) %>
              </p>

              <p>
                <strong>
                  <%= number_to_currency(service.price) %>
                </strong>
              </p>

              <%= link_to "View Service",
                  service_path(service),
                  class: "btn btn-primary" %>

            </div>
          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="alert alert-light border mt-3">
      This coach hasn't added any services yet.
    </div>

  <% end %>

  <!-- Coach Content -->

  <hr class="my-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Content</h2>

    <% if current_user&.id == @coach_profile.user_id %>
      <%= link_to "Create Content",
          new_coach_content_path,
          class: "btn btn-primary" %>
    <% end %>
  </div>

  <% if @coach_contents.any? %>

    <div class="row g-4">

      <% @coach_contents.each do |content| %>

        <div class="col-md-6 col-lg-4">
          <%= render "coach_contents/content",
              content: content,
              member: @member %>
        </div>

      <% end %>

    </div>

  <% else %>

    <div class="alert alert-light border">
      This coach hasn't published any content yet.
    </div>

  <% end %>

</div>

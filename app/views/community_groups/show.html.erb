<div class="container py-5">

  <!-- Community Header -->
  <div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4 p-lg-5">

      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

        <div>

          <h1 class="fw-bold mb-2">
            <%= @community_group.name %>
          </h1>

          <p class="text-muted mb-3">
            <%= @community_group.description %>
          </p>

          <div class="d-flex flex-wrap gap-2">

            <span class="badge bg-primary">
              <i class="bi bi-people"></i>
              <%= @member_count %>
              <%= "member".pluralize(@member_count) %>
            </span>

            <% if @community_group.membership_required %>

              <span class="badge bg-warning text-dark">
                <i class="bi bi-lock"></i>
                Members only
              </span>

            <% else %>

              <span class="badge bg-success">
                <i class="bi bi-globe"></i>
                Public community
              </span>

            <% end %>

          </div>

        </div>

        <div class="d-flex flex-column gap-2">

        <% if user_signed_in? %>

          <% if @membership.present? %>

            <%= button_to "Leave Community",
                community_group_group_membership_path(
                  @community_group,
                  @membership
                ),
                method: :delete,
                class: "btn btn-outline-danger w-100" %>

          <% else %>

            <%= button_to "Join Community",
                community_group_group_memberships_path(@community_group),
                method: :post,
                class: "btn btn-primary w-100" %>

          <% end %>

        <% else %>

          <%= link_to "Sign in to join",
              new_user_session_path,
              class: "btn btn-primary w-100" %>

        <% end %>

      <%= link_to "Back to Communities",
        community_groups_path,
        class: "btn btn-outline-secondary w-100" %>

</div>

      </div>

    </div>

  </div>

  <!-- Community Content -->
  <div class="row g-4">

    <!-- Main Content -->
    <div class="col-lg-8">

      <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

          <div class="d-flex justify-content-between align-items-center mb-4">

  <div>
    <h4 class="fw-bold mb-1">
      Community Hub
    </h4>

    <p class="text-muted mb-0">
      Conversations, photos, links and learning resources.
    </p>
  </div>

  <% if @membership.present? %>

    <%= link_to "Open Hub",
        community_group_community_posts_path(@community_group),
        class: "btn btn-primary" %>

  <% end %>

</div>

<div class="text-center py-5">

  <i class="bi bi-chat-dots display-4 text-primary"></i>

  <h5 class="mt-3">
    Join the discussion
  </h5>

  <p class="text-muted">
    Share questions, resources, photos and conversations
    with other members.
  </p>

  <% if @membership.present? %>

    <%= link_to "Enter Community Hub",
        community_group_community_posts_path(@community_group),
        class: "btn btn-primary" %>

  <% else %>

    <p class="small text-muted mb-0">
      Join this community to access the hub.
    </p>

  <% end %>

</div>

      </div>

    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">

      <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

          <h5 class="fw-bold mb-3">
            About this community
          </h5>

          <p class="text-muted">
            Connect with other students and coaches,
            share knowledge and discuss topics related
            to <%= @community_group.name %>.
          </p>

        </div>

      </div>

    </div>

  </div>

</div>

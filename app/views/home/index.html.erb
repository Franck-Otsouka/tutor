<div class="home-page">

  <!-- Hero -->
  <section class="hero text-center">
    <div class="container">
      <h1 class="display-4 fw-bold">Tutor</h1>

              <p class="lead">
            Learn from experienced coaches and find the right tutor for you.
          </p>

         <% if @featured_video&.media&.attached? %>

  <div class="hero-video my-4">

    <div class="hero-video-wrapper">

      <video
        id="heroVideo"
        class="hero-video-player"
        preload="metadata">

        <source
          src="<%= url_for(@featured_video.media) %>"
          type="<%= @featured_video.media.content_type %>">

      </video>

      <!-- Play button -->
     <button
        type="button"
        class="hero-video-play"
        onclick="
          const v = document.getElementById('heroVideo');
          this.style.display='none';
          v.controls=true;
          v.play();
        ">

        <span>
          <i class="bi bi-play-circle-fill"></i>
        </span>

        <span class="border-animation border-animation--border-1"></span>
        <span class="border-animation border-animation--border-2"></span>

      </button>
      <!-- Text overlay -->
      <div class="hero-video-caption">

        <h3>Learn About Tutor</h3>

        <p>
          Discover expert coaches, live sessions,
          memberships, communities and more.
        </p>

      </div>

    </div>

  </div>

<% end %>

          <div class="hero-actions mt-4">
        <%= link_to "Find a Coach",
            coach_profiles_path,
            class: "btn btn-primary btn-lg me-2" %>

        <%= link_to "Browse Services",
            services_path,
            class: "btn btn-outline-primary btn-lg" %>
      </div>
    </div>
  </section>


  <!-- Categories -->
  <section class="categories-section py-5">
    <div class="container">

      <div class="section-heading text-center mb-4">
        <h2>Explore Categories</h2>
        <p class="text-muted">
          Find the right subject and start learning.
        </p>
      </div>

      <div class="row g-4">
        <% @categories.each do |category| %>
          <div class="col-6 col-md-4 col-lg-3">
            <div class="card category-card h-100">
              <div class="card-body text-center">

                <div class="category-icon">
                  <i class="bi bi-book"></i>
                </div>

                <h5 class="card-title">
                  <%= category.name %>
                </h5>

                <%= link_to "View Services",
                    category_path(category),
                    class: "btn btn-sm btn-outline-primary" %>

              </div>
            </div>
          </div>
        <% end %>
      </div>

    </div>
  </section>


  <!-- Coach Search -->
  <section class="coach-search-section py-5">
    <div class="container">

      <div class="section-heading text-center mb-4">
        <h2>Find Your Coach</h2>
        <p class="text-muted">
          Search for a coach by name, subject, or expertise.
        </p>
      </div>

      <%= form_with url: coach_profiles_path,
          method: :get,
          local: true,
          class: "coach-search-form" do |form| %>

        <div class="input-group input-group-lg">

          <%= form.search_field :query,
              value: params[:query],
              class: "form-control",
              placeholder: "Search coaches, subjects or expertise..." %>

          <%= form.submit "Search",
              class: "btn btn-primary px-4" %>

        </div>

      <% end %>

    </div>
  </section>


  <!-- Featured Coaches -->
<section class="featured-coaches-section py-5">
  <div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="mb-1">Featured Coaches</h2>
        <p class="text-muted mb-0">
          Learn from experienced tutors.
        </p>
      </div>

      <%= link_to "View All",
          coach_profiles_path,
          class: "btn btn-outline-primary" %>
    </div>

    <% if @coach_profiles.present? %>

      <div id="featuredCoachesCarousel"
           class="carousel slide"
           data-bs-ride="carousel">

        <div class="carousel-inner">

          <% @coach_profiles.each_slice(3).with_index do |coaches, index| %>

            <div class="carousel-item <%= "active" if index == 0 %>">

              <div class="row g-4">

                <% coaches.each do |coach| %>

                  <div class="col-12 col-md-6 col-lg-4">

                    <div class="card coach-card h-100">

                      <!-- Avatar -->
                      <div class="coach-card-avatar">
                        <% if coach.user.avatar.attached? %>

                          <%= image_tag coach.user.avatar,
                              class: "home-coach-avatar",
                              alt: "#{coach.user.first_name} #{coach.user.last_name}" %>

                        <% else %>

                          <div class="home-coach-avatar home-coach-avatar-placeholder">
                            <i class="bi bi-person"></i>
                          </div>

                        <% end %>
                      </div>

                      <div class="card-body d-flex flex-column">

                        <!-- Name -->
                        <h5 class="card-title">
                          <%= coach.user.first_name %>
                          <%= coach.user.last_name %>
                        </h5>

                        <!-- Headline -->
                        <p class="coach-headline">
                          <%= coach.headline %>
                        </p>

                        <!-- Rating -->
                        <div class="coach-rating mb-3">

                          <span class="stars"
                                aria-label="<%= coach.average_rating %> out of 5 stars">

                            <% 5.times do |i| %>
                              <i class="bi <%= i < coach.average_rating.round ? 'bi-star-fill' : 'bi-star' %>"></i>
                            <% end %>

                          </span>

                          <span class="rating-value">
                            <%= coach.average_rating %>
                          </span>

                          <span class="rating-count">
                            (<%= coach.reviews_count %> reviews)
                          </span>

                        </div>

                        <!-- Description -->
                        <p class="card-text text-muted">
                          <%= truncate(coach.description, length: 120) %>
                        </p>

                        <!-- Experience -->
                        <div class="coach-meta mb-3">
                          <span>
                            <i class="bi bi-award"></i>
                            <%= coach.years_experience %> years experience
                          </span>
                        </div>

                        <!-- Profile -->
                        <%= link_to "View Profile",
                            coach_profile_path(coach),
                            class: "btn btn-primary mt-auto" %>

                      </div>

                    </div>

                  </div>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>

        <!-- Previous -->
        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#featuredCoachesCarousel"
                data-bs-slide="prev">

          <span class="carousel-control-prev-icon"></span>
          <span class="visually-hidden">Previous</span>

        </button>

        <!-- Next -->
        <button class="carousel-control-next"
                type="button"
                data-bs-target="#featuredCoachesCarousel"
                data-bs-slide="next">

          <span class="carousel-control-next-icon"></span>
          <span class="visually-hidden">Next</span>

        </button>

      </div>

    <% else %>

      <div class="empty-state text-center py-5">
        <i class="bi bi-people display-5 text-muted"></i>

        <h4 class="mt-3">No coaches available yet</h4>

        <p class="text-muted">
          Check back soon for featured coaches.
        </p>
      </div>

    <% end %>

  </div>
</section>

</div>

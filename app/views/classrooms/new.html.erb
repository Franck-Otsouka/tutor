<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Create a Classroom</h1>
        <p class="text-muted mb-0">
          Create a private space for your study group.
        </p>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">

          <%= form_with model: @classroom, local: true do |form| %>

            <% if @classroom.errors.any? %>
              <div class="alert alert-danger">
                <h6 class="fw-bold">
                  Please fix the following:
                </h6>

                <ul class="mb-0">
                  <% @classroom.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-4">
              <%= form.label :name,
                  "Classroom name",
                  class: "form-label fw-semibold" %>

              <%= form.text_field :name,
                  class: "form-control form-control-lg",
                  placeholder: "e.g. Ruby Study Group" %>
            </div>

            <div class="mb-4">
              <%= form.label :description,
                  "Description",
                  class: "form-label fw-semibold" %>

              <%= form.text_area :description,
                  rows: 5,
                  class: "form-control",
                  placeholder: "What is this classroom about?" %>
            </div>

            <div class="mb-4">
              <div class="form-check">
                <%= form.check_box :private,
                    class: "form-check-input" %>

                <%= form.label :private,
                    "Private classroom",
                    class: "form-check-label fw-semibold" %>
              </div>

              <div class="form-text">
                Private classrooms are intended for invited students.
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <%= link_to "Cancel",
                  classrooms_path,
                  class: "btn btn-outline-secondary" %>

              <%= form.submit "Create Classroom",
                  class: "btn btn-primary px-4" %>
            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>

<div class="feed-page container-fluid px-3 px-lg-4 py-4">

  <!-- Search -->
  <div class="container mb-4">

    <div class="card shadow-sm border-0">
      <div class="card-body p-3">

        <%= form_with url: feed_path,
            method: :get,
            local: true do |form| %>

          <div class="input-group input-group-lg">

            <span class="input-group-text bg-white">
              <i class="bi bi-search"></i>
            </span>

            <%= form.search_field :query,
                value: params[:query],
                class: "form-control border-start-0",
                placeholder: "Search coaches, subjects, services and content..." %>

            <%= form.submit "Search",
                class: "btn btn-primary px-4" %>

          </div>

        <% end %>

      </div>
    </div>

  </div>


  <!-- Feed Layout -->
  <div class="feed-container">

  <div class="row g-4 feed-layout">

      <!-- Left: User Profile -->
      <div class="col-lg-3">

        <div class="card shadow-sm border-0">

          <div class="card-body text-center">

            <% if user_signed_in? %>

              <!-- Avatar -->

              <div class="mb-3">

                <% if current_user.avatar.attached? %>

                  <%= image_tag current_user.avatar,
                      class: "rounded-circle",
                      style: "width: 100px; height: 100px; object-fit: cover;",
                      alt: "#{current_user.first_name} #{current_user.last_name}" %>

                <% else %>

                  <div
                    class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
                    style="width: 100px; height: 100px; font-size: 2.5rem;">

                    <i class="bi bi-person"></i>

                  </div>

                <% end %>

              </div>


              <!-- Name -->

              <h5 class="mb-1">

                <%= current_user.first_name %>
                <%= current_user.last_name %>

              </h5>


              <!-- Role -->

              <div class="mb-3">

                <% if current_user.coach? %>

                  <span class="badge bg-success">
                    Coach
                  </span>

                <% elsif current_user.student? %>

                  <span class="badge bg-primary">
                    Student
                  </span>

                <% elsif current_user.admin? %>

                  <span class="badge bg-danger">
                    Admin
                  </span>

                <% end %>

              </div>


              <!-- User information -->

              <div class="text-muted small text-start">

                <div class="mb-2">
                  <i class="bi bi-envelope me-2"></i>
                  <%= current_user.email %>
                </div>

                <% if current_user.bio.present? %>

                  <div class="mb-2">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    <%= truncate(current_user.bio, length: 100) %>
                  </div>

                <% end %>

              </div>


              <!-- Profile link -->

              <% if current_user.coach? && current_user.coach_profile.present? %>

                <%= link_to "My Coach Profile",
                    coach_profile_path(current_user.coach_profile),
                    class: "btn btn-outline-primary btn-sm w-100 mt-3" %>

              <% elsif current_user.student_profile&.persisted? %>

                <%= link_to "My Profile",
                    student_profile_path(current_user.student_profile),
                    class: "btn btn-outline-primary btn-sm w-100 mt-3" %>

              <% end %>


            <% else %>

              <div class="py-3">

                <div class="mb-3">
                  <i class="bi bi-person-circle display-3 text-muted"></i>
                </div>

                <h5>Join Tutor</h5>

                <p class="text-muted small">
                  Sign in to personalize your Tutor feed.
                </p>

                <%= link_to "Sign in",
                    new_user_session_path,
                    class: "btn btn-primary btn-sm" %>

              </div>

            <% end %>

          </div>

        </div>

          <!-- People Online -->
      <div class="card shadow-sm border-0 mt-4">

        <div class="card-body">

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">
              <i class="bi bi-people me-2"></i>
              People Online
            </h6>

            <span class="badge bg-success">
              Online
            </span>
          </div>

          <div class="d-flex flex-column gap-3">

            <% @online_users.each do |user| %>

              <%= link_to "#",
                  class: "text-decoration-none text-dark d-flex align-items-center" do %>

                <!-- Avatar -->
                <div class="position-relative me-2">

                  <% if user.avatar.attached? %>

                    <%= image_tag user.avatar,
                        class: "rounded-circle",
                        style: "width: 42px; height: 42px; object-fit: cover;",
                        alt: "#{user.first_name} #{user.last_name}" %>

                  <% else %>

                    <div
                      class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                      style="width: 42px; height: 42px;">

                      <i class="bi bi-person"></i>

                    </div>

                  <% end %>

                  <!-- Online indicator -->
                  <span
                    class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle"
                    style="width: 11px; height: 11px;">
                  </span>

                </div>

                <!-- User information -->
                <div class="flex-grow-1 overflow-hidden">

                  <div class="fw-semibold text-truncate">
                    <%= user.first_name.presence || user.email.split("@").first %>
                    <%= user.last_name %>
                  </div>

                  <small class="text-muted">
                    <%= user.role.humanize %>
                  </small>

                </div>

              <% end %>

            <% end %>

          </div>

          <% if @online_users.empty? %>

            <p class="text-muted small text-center mb-0">
              No other users are online.
            </p>

          <% end %>

        </div>

      </div>


      </div>


      <!-- Middle: Feed -->
      <div class="col-lg-6 feed-column">

        <% if @contents.any? %>

              <div class="feed-scroll">

                <div class="d-flex flex-column gap-4">

                  <% @contents.each do |content| %>

                    <%= render "coach_contents/content",
                        content: content,
                        member: false %>

                  <% end %>

                </div>

              </div>

            <% else %>

          <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

              <i class="bi bi-newspaper display-4 text-muted"></i>

              <h5 class="mt-3">
                No content yet
              </h5>

              <p class="text-muted">
                Coaches haven't published any public content yet.
              </p>

            </div>

          </div>

        <% end %>

      </div>


      <!-- Right: Advertising / Sponsorship -->
      <div class="col-lg-3">

        <div class="card shadow-sm border-0 mb-4">

          <div class="card-body">

            <h5 class="mb-3">
              <i class="bi bi-megaphone me-2"></i>
              Sponsored
            </h5>

            <div class="border rounded p-3 mb-3">

              <small class="text-muted">
                Sponsored
              </small>

              <h6 class="mt-2">
                Your advertisement here
              </h6>

              <p class="small text-muted mb-0">
                Reach students and coaches on Tutor.
              </p>

            </div>

          </div>

        </div>


        <div class="card shadow-sm border-0 mb-4">

          <div class="card-body">

            <h5 class="mb-3">
              <i class="bi bi-mortarboard me-2"></i>
              Bursaries
            </h5>

            <div class="border rounded p-3">

              <h6>
                Bursary opportunities
              </h6>

              <p class="small text-muted">
                Scholarships and funding opportunities
                for students.
              </p>

              <%= link_to "View opportunities",
                  "#",
                  class: "btn btn-outline-primary btn-sm" %>

            </div>

          </div>

        </div>


        <div class="card shadow-sm border-0">

          <div class="card-body">

            <h5 class="mb-3">
              <i class="bi bi-calendar-event me-2"></i>
              Opportunities
            </h5>

            <p class="small text-muted">
              Events, workshops, competitions and
              other opportunities will appear here.
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>

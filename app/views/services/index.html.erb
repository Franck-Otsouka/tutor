<div class="container py-5 services-page">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div class="page-header">
      <h1>Coaching Services</h1>

      <p class="text-muted">
        Find a service that matches what you want to learn.
      </p>
    </div>

    <% if user_signed_in? && current_user.coach_profile %>
      <%= link_to "Create Service",
          new_service_path,
          class: "btn btn-primary" %>
    <% end %>

  </div>

  <!-- Search -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

      <%= form_with url: services_path,
          method: :get,
          local: true,
          class: "row g-2" do |f| %>

        <div class="col">
          <%= f.text_field :query,
              value: params[:query],
              class: "form-control",
              placeholder: "Search services..." %>
        </div>

        <div class="col-auto">
          <%= f.submit "Search",
              class: "btn btn-primary" %>
        </div>

      <% end %>

    </div>
  </div>

  <!-- Categories -->
  <div class="mb-4">

    <% Category.order(:name).each do |category| %>

      <%= link_to category.name,
          services_path(category_id: category.id),
          class: "btn btn-sm btn-outline-secondary me-2 mb-2" %>

    <% end %>

  </div>

  <!-- Services Grid -->
  <div class="row g-4">

    <% @services.each do |service| %>

      <!-- service cards -->

    <% end %>

  </div>

  <div class="row g-4">
    <% @services.each do |service| %>
      <div class="col-md-6 col-lg-4">
        <div class="card service-card h-100">
          <div class="card-body">
            <span class="badge bg-secondary mb-2 service-category">
              <%= service.category.name %>
            </span>

            <h4 class="service-title"><%= service.title %></h4>
            <p>
              <%= truncate(service.description, length: 150) %>
            </p>

            <p class="mb-1">
              <strong>Coach:</strong>
              <%= service.coach_profile.user.first_name %>
              <%= service.coach_profile.user.last_name %>
            </p>

            <p class="service-duration mb-1">
              <strong>Duration:</strong>
              <%= service.duration %> minutes
            </p>

            <p class="service-price mb-3">
              <strong>Price:</strong>
              <%= number_to_currency(service.price) %>
            </p>

            <%= link_to "View Service",
                service_path(service),
                class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="mt-5 d-flex justify-content-center">
  <%= paginate @services %>
  </div>
</div>

<div class="container py-5">

  <div class="d-flex flex-column flex-md-row
              justify-content-between align-items-md-center
              gap-3 mb-5">

    <div>
      <h1 class="h2 fw-bold mb-1">
        My Content
      </h1>

      <p class="text-muted mb-0">
        Manage the posts, photos, and videos on your coach profile.
      </p>
    </div>

    <%= link_to new_coach_content_path,
        class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>
      Create Content
    <% end %>

  </div>


  <% if @coach_contents.any? %>

    <div class="row g-4">

      <% @coach_contents.each do |content| %>

        <div class="col-md-6 col-xl-4">

          <div class="card border-0 shadow-sm h-100">

            <% if content.media.attached? %>

              <% if content.media.content_type.start_with?("image/") %>

                <%= image_tag content.media,
                    class: "card-img-top",
                    style: "height: 220px; object-fit: cover;",
                    alt: content.title %>

              <% elsif content.media.content_type.start_with?("video/") %>

                <video
                  class="w-100"
                  style="height: 220px; object-fit: cover;"
                  controls>
                  <source src="<%= url_for(content.media) %>"
                          type="<%= content.media.content_type %>">
                </video>

              <% end %>

            <% end %>


            <div class="card-body p-4">

              <div class="d-flex justify-content-between
                          align-items-start gap-2 mb-3">

                <h2 class="h5 mb-0">
                  <%= content.title %>
                </h2>

                <% if content.members_only? %>

                  <span class="badge bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-lock-fill me-1"></i>
                    Members
                  </span>

                <% else %>

                  <span class="badge bg-success-subtle text-success">
                    <i class="bi bi-globe2 me-1"></i>
                    Public
                  </span>

                <% end %>

              </div>


              <div class="small text-muted mb-3">

                <% if content.post? %>
              <i class="bi bi-file-text me-1"></i>
              Post
            <% elsif content.photo? %>
              <i class="bi bi-image me-1"></i>
              Photo
            <% elsif content.video? %>
              <i class="bi bi-camera-video me-1"></i>
              Video
            <% end %>

                ·
                <%= time_ago_in_words(content.created_at) %>
                ago

              </div>


              <% if content.content.present? %>

                <p class="text-muted mb-0">
                  <%= truncate(content.content, length: 140) %>
                </p>

              <% end %>

            </div>


            <div class="card-footer bg-transparent
                        border-top-0 px-4 pb-4">

              <div class="d-flex gap-2">

                <%= link_to coach_content_path(content),
                    class: "btn btn-sm btn-outline-secondary" do %>
                  <i class="bi bi-eye me-1"></i>
                  View
                <% end %>

                <%= link_to edit_coach_content_path(content),
                    class: "btn btn-sm btn-outline-primary" do %>
                  <i class="bi bi-pencil me-1"></i>
                  Edit
                <% end %>

                <%= button_to coach_content_path(content),
                    method: :delete,
                    class: "btn btn-sm btn-outline-danger",
                    form: {
                      data: {
                        turbo_confirm: "Delete this content?"
                      }
                    } do %>
                  <i class="bi bi-trash"></i>
                <% end %>

              </div>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="card border-0 shadow-sm">

      <div class="card-body text-center py-5">

        <i class="bi bi-collection-play
                  display-5 text-muted"></i>

        <h2 class="h5 mt-3">
          No content yet
        </h2>

        <p class="text-muted mb-4">
          Share your knowledge with your audience.
        </p>

        <%= link_to new_coach_content_path,
            class: "btn btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i>
          Create Your First Content
        <% end %>

      </div>

    </div>

  <% end %>

</div>

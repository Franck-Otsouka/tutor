<div class="container py-5">

  <div class="row justify-content-center">

    <div class="col-12 col-lg-8">

      <div class="mb-4">
        <%= link_to "← Back to My Content",
            coach_contents_path,
            class: "text-decoration-none" %>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <% if @coach_content.media.attached? %>

          <% if @coach_content.media.content_type.start_with?("image/") %>

            <%= image_tag @coach_content.media,
                class: "w-100",
                style: "max-height: 500px; object-fit: cover;",
                alt: @coach_content.title %>

          <% elsif @coach_content.media.content_type.start_with?("video/") %>

            <video
              class="w-100"
              controls
              style="max-height: 500px;">
              <source
                src="<%= url_for(@coach_content.media) %>"
                type="<%= @coach_content.media.content_type %>">
              Your browser does not support video playback.
            </video>

          <% end %>

        <% end %>


        <div class="card-body p-4 p-md-5">

          <div class="d-flex flex-wrap
                      justify-content-between
                      align-items-start
                      gap-2 mb-3">

            <div>

              <span class="badge bg-light text-dark mb-2">
                <% if @coach_content.post? %>
                    <i class="bi bi-file-text me-1"></i>
                    Post
                  <% elsif @coach_content.photo? %>
                    <i class="bi bi-image me-1"></i>
                    Photo
                  <% elsif @coach_content.video? %>
                    <i class="bi bi-camera-video me-1"></i>
                    Video
                <% end %>
              </span>

              <% if @coach_content.members_only? %>

                <span class="badge bg-warning-subtle
                             text-warning-emphasis">
                  <i class="bi bi-lock-fill me-1"></i>
                  Members only
                </span>

              <% else %>

                <span class="badge bg-success-subtle
                             text-success">
                  <i class="bi bi-globe2 me-1"></i>
                  Public
                </span>

              <% end %>

            </div>

          </div>


          <h1 class="h2 fw-bold mb-3">
            <%= @coach_content.title %>
          </h1>


          <div class="text-muted small mb-4">
            Published
            <%= time_ago_in_words(@coach_content.created_at) %>
            ago
          </div>


          <% if @coach_content.content.present? %>

            <div class="fs-5">
              <%= simple_format(@coach_content.content) %>
            </div>

          <% end %>


          <div class="border-top mt-4 pt-4">

            <div class="d-flex gap-2">

              <%= link_to edit_coach_content_path(@coach_content),
                  class: "btn btn-outline-primary" do %>
                <i class="bi bi-pencil me-1"></i>
                Edit
              <% end %>

              <%= button_to coach_content_path(@coach_content),
                  method: :delete,
                  class: "btn btn-outline-danger",
                  form: {
                    data: {
                      turbo_confirm: "Delete this content?"
                    }
                  } do %>
                <i class="bi bi-trash me-1"></i>
                Delete
              <% end %>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>

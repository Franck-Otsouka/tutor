<div class="container py-5">

  <div class="row justify-content-center">

    <div class="col-12 col-lg-8">

      <div class="mb-4">
        <%= link_to "← Back to My Content",
            coach_contents_path,
            class: "text-decoration-none" %>
      </div>

      <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-md-5">

          <div class="mb-4">
            <h1 class="h2 fw-bold mb-2">
              Create Content
            </h1>

            <p class="text-muted mb-0">
              Share posts, photos, and videos with your audience.
            </p>
          </div>


          <%= form_with model: @coach_content,
              url: coach_contents_path,
              local: true,
              multipart: true do |form| %>


            <% if @coach_content.errors.any? %>

              <div class="alert alert-danger">

                <h6 class="fw-bold">
                  Please correct the following:
                </h6>

                <ul class="mb-0">

                  <% @coach_content.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>

                </ul>

              </div>

            <% end %>


            <div class="mb-4">

              <%= form.label :title,
                  "Title",
                  class: "form-label fw-semibold" %>

              <%= form.text_field :title,
                  class: "form-control form-control-lg",
                  placeholder: "Give your content a title" %>

            </div>


            <div class="mb-4">

              <%= form.label :content,
                  "Description",
                  class: "form-label fw-semibold" %>

              <%= form.text_area :content,
                  class: "form-control",
                  rows: 6,
                  placeholder: "Write something for your audience..." %>

            </div>


            <div class="mb-4">

              <%= form.label :content_type,
                  "Content Type",
                  class: "form-label fw-semibold" %>

              <%= form.select :content_type,
                  [
                    ["📝 Post", "post"],
                    ["📷 Photo", "photo"],
                    ["🎥 Video", "video"]
                  ],
                  {},
                  class: "form-select" %>

            </div>


            <div class="mb-4">

              <%= form.label :visibility,
                  "Who can see this?",
                  class: "form-label fw-semibold" %>

              <%= form.select :visibility,
                  [
                    ["🌍 Everyone", "public_content"],
                    ["🔒 Members only", "members_only"]
                  ],
                  {},
                  class: "form-select" %>

              <div class="form-text">
                Members-only content is available to users
                with an active membership.
              </div>

            </div>


            <div class="mb-4">

              <%= form.label :media,
                  "Photo or Video",
                  class: "form-label fw-semibold" %>

              <%= form.file_field :media,
                  class: "form-control",
                  accept: "image/*,video/*" %>

              <div class="form-text">
                Optional. Upload an image or video.
              </div>

            </div>


            <div class="d-flex justify-content-end gap-2">

              <%= link_to "Cancel",
                  coach_contents_path,
                  class: "btn btn-outline-secondary" %>

              <%= form.submit "Publish Content",
                  class: "btn btn-primary" %>

            </div>

          <% end %>

        </div>

      </div>

    </div>

  </div>

</div>
